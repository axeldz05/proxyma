{
    "type": "bidi_stream",
    "exec": "uv run --project __SERVICES_DIR__ python __SERVICES_DIR__/remote/input/main.py",
    "schema": {
        "name": "remote.input",
        "type": "bidi_stream",
        "description": "Lab remote input channel (echo). Share session_id with remote.screen.",
        "parameters": {
            "session_id": {
                "type": "string",
                "required": false,
                "description": "Must match remote.screen session"
            }
        },
        "outputs": {
            "status": {"type": "string"}
        }
    }
}
