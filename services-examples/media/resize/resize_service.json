{
    "type": "script",
    "exec": "uv run --project __SERVICES_DIR__ python __SERVICES_DIR__/media/resize/main.py",
    "schema": {
        "name": "media.resize",
        "description": "Resize an image to width x height",
        "parameters": {
            "input_path": {
                "type": "file",
                "required": true,
                "uiHint": "image_picker"
            },
            "width": {"type": "int", "required": false},
            "height": {"type": "int", "required": false},
            "output_path": {"type": "string", "required": false}
        },
        "outputs": {
            "status": {"type": "string"},
            "output_path": {"type": "file"},
            "width": {"type": "int"},
            "height": {"type": "int"},
            "message": {"type": "string"}
        }
    }
}
